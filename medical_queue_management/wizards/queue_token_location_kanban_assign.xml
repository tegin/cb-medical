<odoo>

    <record model="ir.ui.view" id="queue_token_location_kanban_assign_form_view">
        <field name="model">queue.token.location.kanban.assign</field>
        <field name="arch" type="xml">
            <form string="Queue Token Location Kanban Assign">
                <!-- TODO -->
                <group>
                    <field name="token_location_id" invisible="1" />
                    <field name="location_id" domain="[('group_ids', '=', group_id)]" />
                    <field name="group_id" invisible="1" />
                    <field name="do_not_call" invisible="1" />
                </group>
                <footer>
                    <button
                        name="assign"
                        string="Assign"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="queue_token_location_kanban_assign_act_window"
    >
        <field name="name">Queue Token Location Kanban Assign</field> <!-- TODO -->
        <field name="res_model">queue.token.location.kanban.assign</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


</odoo>
