<odoo>
    <record id="action_medical_encounter_admin_validate" model="ir.actions.server">
        <field name="name">Validate</field>
        <field
            name="model_id"
            ref="medical_administration_encounter.model_medical_encounter"
        />
        <field
            name="binding_model_id"
            ref="medical_administration_encounter.model_medical_encounter"
        />
        <field name="binding_view_types">list</field>
        <field
            name="groups_id"
            eval="[(4, ref('pos_validation.group_medical_receptionist_manager'))]"
        />
        <field name="state">code</field>
        <field name="code">
for record in records:
    record.admin_validate()
        </field>
    </record>
</odoo>
