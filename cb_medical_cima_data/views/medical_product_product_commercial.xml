<odoo>

    <record model="ir.ui.view" id="medical_product_product_commercial_form_view">
        <field
            name="name"
        >medical.product.product.commercial.form (in cb_medical_cima_data)</field>
        <field name="model">medical.product.product.commercial</field>
        <field
            name="inherit_id"
            ref="cb_medical_product_request.medical_product_product_commercial_form_view"
        />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="name_cima" colspan="2" readonly="1" />
            </field>
            <field name="name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="medical_product_product_commercial_tree_view">
        <field
            name="name"
        >medical.product.product.commercial.tree (in cb_medical_cima_data)</field>
        <field name="model">medical.product.product.commercial</field>
        <field
            name="inherit_id"
            ref="cb_medical_product_request.medical_product_product_commercial_tree_view"
        />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="name_cima" />
            </field>
            <field name="name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>



</odoo>
