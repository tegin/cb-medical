<odoo>

    <record model="ir.ui.view" id="medical_product_template_form_view">
        <field
            name="name"
        >medical.product.template.form (in cb_medical_cima_data)</field>
        <field name="model">medical.product.template</field>
        <field
            name="inherit_id"
            ref="cb_medical_product_request.medical_product_template_form_view"
        />
        <field name="arch" type="xml">
            <field name="name_template" position="after">
                <field name="name_template_cima" colspan="2" readonly="1" />
            </field>
            <field name="name_template" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_product_template_tree_view">
        <field
            name="name"
        >medical.product.template.tree (in cb_medical_cima_data)</field>
        <field name="model">medical.product.template</field>
        <field
            name="inherit_id"
            ref="medical_product_request.medical_product_template_tree_view"
        />
        <field name="arch" type="xml">
            <field name="name_template" position="after">
                <field name="name_template_cima" />
            </field>
            <field name="name_template" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>



</odoo>
