<odoo>

    <record model="ir.ui.view" id="medical_clinical_impression_template_form_view">
        <field name="model">medical.clinical.impression.template</field>
        <field
            name="inherit_id"
            ref="medical_clinical_impression.medical_clinical_impression_template_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']/.." position="after">
                <field name="concept_ids">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle" />
                        <field name="concept_id" />
                    </tree>
                    <form>
                        <sheet>
                            <group>
                                <field name="concept_id" />
                            </group>
                        </sheet>
                    </form>
                </field>
            </xpath>
        </field>
    </record>



</odoo>
